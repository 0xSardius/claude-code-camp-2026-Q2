## Architecture changes, file by file

### `Models` (NEW — `boukensha/models.py`)

```python
TABLE = {
    "claude-opus-4-8": {"context_window": 200_000},
    "claude-sonnet-4-6": {"context_window": 200_000},
    "claude-haiku-4-5": {"context_window": 200_000},
    "claude-sonnet-5": {"context_window": 1_000_000},
}
DEFAULT_CONTEXT_WINDOW = 32_000


def context_window(model):
    entry = TABLE.get(str(model))
    return entry["context_window"] if entry is not None else DEFAULT_CONTEXT_WINDOW
```
Ruby: `TABLE.dig(model.to_s, :context_window) || DEFAULT_CONTEXT_WINDOW` —
`||` here only matters if `context_window` itself could be nil/false in a
present entry, which it never is in a hand-written literal table; `.get()`
+ explicit `is not None` check is the faithful translation regardless.

### `Config` (rewritten, carries no `PROMPTS_DIR` anymore)

```python
class Config:
    DEFAULT_DIR = str(Path.home() / ".boukensha")

    def __init__(self):
        self.dir = self._resolve_dir()
        self._load_env()
        self.settings = self._load_settings()
        self.system_prompt = self._load_system_prompt()

    @property
    def provider_type(self):
        v = self.dig("tasks", "player", "provider")
        return v if v is not None else "anthropic"

    @property
    def model(self):
        v = self.dig("tasks", "player", "model")
        return v if v is not None else "claude-haiku-4-5"

    def system_override(self):
        return self.dig("system", "override") is True

    # mud_host/mud_port/mud_username/mud_password: unchanged from 11_tui.

    def agent_max_iterations(self):
        v = self.dig("agent", "max_iterations")
        return 25 if v is None else int(v)

    def agent_max_output_tokens(self):
        v = self.dig("agent", "max_output_tokens")
        return 1024 if v is None else int(v)

    def agent_max_turn_tokens(self):
        v = self.dig("agent", "max_turn_tokens")
        return 60_000 if v is None else int(v)

    def agent_compaction_threshold(self):
        v = self.dig("agent", "compaction_threshold")
        return 0.85 if v is None else float(v)

    # dig(), __repr__, _resolve_dir() (3-tier, unchanged from 11), _load_env(): unchanged.

    def _load_settings(self):
        # unchanged from 11_tui

    def _load_system_prompt(self):
        if self.dig("tasks", "player", "prompt_override", "system") is True:
            task_file = Path(self.dir) / "prompts" / "player" / "system.md"
            if task_file.exists():
                return task_file.read_text().strip()
        system_file = Path(self.dir) / "prompts" / "system.md"
        return system_file.read_text().strip() if system_file.exists() else None
```

