#!/usr/bin/env bash
# Live MUD smoke test. Sources the repo-root .env first so the real API key
# wins over the week1 placeholder in .boukensha/.env (python-dotenv does not
# override an already-set variable).
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"
[ -f "$root/.env" ] && { set -a; . "$root/.env"; set +a; }
cd "$here/../python"
exec uv run python examples/smoke_mud.py "$@"
