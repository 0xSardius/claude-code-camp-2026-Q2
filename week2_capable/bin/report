#!/usr/bin/env bash
# Session summary reporter. Resolves logs from the repo-root .boukensha/
# (same directory examples/example.py points at), not ~/.boukensha.
cd "$(dirname "$0")/../python"
export BOUKENSHA_DIR="${BOUKENSHA_DIR:-$(cd ../.. && pwd)/.boukensha}"
uv run python -m boukensha.report "$@"
